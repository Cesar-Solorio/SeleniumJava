# --- Archivos específicos del proyecto ---
src/main/java/Resources/Wrapper.java
.idea/
target/

# Ignora todo el contenido dentro de Reports
Reports/*
# Excepción: no ignorar la carpeta OnlyThis
!Reports/OnlyThis/
